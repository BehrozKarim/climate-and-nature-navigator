# Default paths are auto-detected relative to this standalone backend.
# WEATHERLENS_DATASET_ROOT=C:/path/to/APETIT_CLIMATE_NATURE_NAVIGATOR_2026
# WEATHERLENS_DOCUMENT_ROOT=C:/path/to/new documents
# WEATHERLENS_DB=C:/path/to/weatherlens.sqlite3
# Set a strong random bearer token before using a shared host.
WEATHERLENS_API_TOKEN=
WEATHERLENS_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Optional HTTPS OpenAI-compatible endpoint. All three must be set to call it.
# These remain empty by default; local extractive retrieval needs no paid provider.
WEATHERLENS_LLM_BASE_URL=
WEATHERLENS_LLM_API_KEY=
WEATHERLENS_LLM_MODEL=
